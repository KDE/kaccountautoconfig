<?xml version="1.0"?>
<clientConfig version="1.2">
    <emailProvider id="email.provider.com">
        <domain>email.provider.com</domain>

        <displayName>Email provider</displayName>

        <incomingServer type="imap">
            <hostname>email.provider.com</hostname>
            <port>993</port>
            <socketType>SSL</socketType>
            <authentication>password-cleartext</authentication>
            <username>%EMAILADDRESS%</username>
        </incomingServer>

    </emailProvider>

</clientConfig>
